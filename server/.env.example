# --- Base de datos (PostgreSQL) ---
DB_NAME=dndworld
DB_USER=postgres
DB_PASS=tu_password
DB_HOST=localhost

# --- Auth ---
JWT_SECRET=cambia_esto_por_un_secreto_largo

# --- Servidor ---
PORT=3001

# --- Amazon S3 (imágenes, mapas, renders y audio) ---
# Bucket sugerido: prismadevs-dndworld-media-us-east-2
AWS_REGION=us-east-2
S3_BUCKET=prismadevs-dndworld-media-us-east-2
# Separa objetos locales y productivos dentro del mismo bucket.
S3_PREFIX=development
# URL pública del bucket o, preferentemente, del CDN/CloudFront sin slash final.
# Si se omite se genera la URL pública estándar de S3.
S3_PUBLIC_BASE_URL=http://localhost:3001/api/media
# En EC2 se recomienda usar un IAM Role. Para desarrollo local, AWS SDK también
# admite AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY o el perfil ~/.aws/credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Opcionales para MinIO/R2 u otro S3 compatible:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- OpenAI (render del héroe con equipo, gpt-image-1) ---
# Necesaria para el botón "Sincronizar héroe". Sin esto, el endpoint
# /api/characters/:id/render devuelve 503.
OPENAI_API_KEY=sk-...

# --- DM Assistant (conversacion + tools) ---
# Modelo sugerido para interpretar lenguaje natural del DM y decidir uso de tools.
DM_ASSISTANT_MODEL=gpt-4o-mini
