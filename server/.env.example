# Copy to .env only for an isolated local development database.
NODE_ENV=development
DB_NAME=dndworld_demo
DB_USER=postgres
DB_PASS=replace_with_your_local_database_password
DB_HOST=127.0.0.1
# Default startup does NOT change the schema. Set alter for local initialization only.
DB_SYNC_MODE=none
RUN_STARTUP_SEED=false
JWT_SECRET=replace_with_a_random_local_secret
PORT=3001

# Optional paid/external integrations. Leave empty for code review and unit tests.
# Without S3, media uploads/streaming are unavailable.
AWS_REGION=us-east-2
S3_BUCKET=
S3_PREFIX=development
S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Image generation and the DM assistant require a separately configured account.
OPENAI_API_KEY=
DM_ASSISTANT_MODEL=gpt-4o-mini
